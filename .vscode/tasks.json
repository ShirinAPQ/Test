{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\Program Files\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall", // 新增：开启所有编译警告，方便调试
                "${file}",
                "-I", "C:\\Program Files\\MySQL\\MySQL Connector C++ 9.6\\include",
                "-L", "C:\\Program Files\\MySQL\\MySQL Connector C++ 9.6\\lib64\\vs14",
                "-lmysqlcppconn", // 修改：合并 -l 和库名，消除兼容性风险
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe" // 修改：删除末尾多余逗号
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "适配MySQL Connector/C++ 9.6版本"
        }
    ],
    "version": "2.0.0"
}